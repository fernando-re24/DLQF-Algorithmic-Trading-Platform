# Supabase Auth
SUPABASE_URL=https://<project-ref>.supabase.co
SUPABASE_ANON_KEY=

# AWS
AWS_REGION=us-east-1
# Set if not using IAM role / instance profile
# AWS_ACCESS_KEY_ID=
# AWS_SECRET_ACCESS_KEY=

# S3
S3_SUBMISSIONS_BUCKET=dlqf-submissions-dev-vt
S3_DATASETS_BUCKET=dlqf-datasets-dev-vt

# SQS
SQS_JOBS_URL=

# DynamoDB tables
DYNAMO_USERS_TABLE=dlqf_users
DYNAMO_PROJECTS_TABLE=dlqf_projects
DYNAMO_JOBS_TABLE=dlqf_jobs
DYNAMO_JOB_RUNS_TABLE=dlqf_job_runs
DYNAMO_RESULTS_TABLE=dlqf_results

# CORS — origin of the Next.js dev server
FRONTEND_ORIGIN=http://localhost:3000

# macOS SSL fix (point to certifi cacert.pem if you hit SSL errors)
# SSL_CERT_FILE=
