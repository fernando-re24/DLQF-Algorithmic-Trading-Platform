    "swr": "2.2.5"
  },
  "devDependencies": {
    "@types/node": "20.14.10",
    "@types/react": "18.3.3",
    "@types/react-dom": "18.3.0",
    "eslint": "8.57.0",
    "eslint-config-next": "14.2.15",
    "openapi-typescript": "7.4.0",
    "prettier": "3.3.3",
    "typescript": "5.5.4"
  },
  "packageManager": "pnpm@9.10.0"
